# NEXORA RIDE - Backend Environment Configuration Example
# Copy to .env for local development

# Application Configuration
APP_NAME="NEXORA RIDE Backend"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false

# Database Connection URL
# For local zero-config demo / test SQLite:
DATABASE_URL="sqlite:///./nexora_ride.db"

# For Production / Staging PostgreSQL:
# DATABASE_URL="postgresql://nexora_user:your_secure_password@localhost:5432/nexora_ride"

# CORS Allowed Origins
CORS_ORIGINS=["*"]

# Demo Customer Identity Profile
DEMO_CUSTOMER_ID="cust_demo_01"
DEMO_CUSTOMER_NAME="Arjun Sharma"
DEMO_CUSTOMER_PHONE="+919876543210"

# NETWORKING INSTRUCTIONS FOR MOBILE CLIENT:
# 1. Android Emulator: Access backend at http://10.0.2.2:8000
# 2. Physical Android Device (LAN): Access backend at http://<YOUR_COMPUTER_LAN_IP>:8000 (e.g. http://192.168.1.5:8000)
# 3. Web / Localhost Desktop: Access backend at http://127.0.0.1:8000
