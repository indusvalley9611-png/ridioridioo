# NEXORA RIDE - Environment Configuration Example (Phase 3)
# Copy this file to .env for local development

# App Environment
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME="NEXORA RIDE"
EXPO_PUBLIC_APP_VERSION=1.0.0

# Backend API URL (Phase 3)
# - Android Emulator: http://10.0.2.2:8000
# - Physical Android Device (LAN): http://<YOUR_COMPUTER_LAN_IP>:8000 (e.g. http://192.168.1.5:8000)
# - Web / Localhost Desktop: http://127.0.0.1:8000
# If not specified or server is unreachable, app gracefully runs in Local Demo Storage Mode.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Google Maps & Geocoding Configuration
# Optional: If not provided, NEXORA RIDE runs in graceful Fallback / Demo Geocoding Mode with Bengaluru locations.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Routing Provider (Optional)
# Options: "osrm" | "google" | "mock" (default is "mock" for graceful offline/demo estimates)
EXPO_PUBLIC_ROUTING_PROVIDER=mock

# Map Fallback Mode: Set to "true" to force test the interactive vector fallback map
EXPO_PUBLIC_FORCE_MAP_FALLBACK=false
